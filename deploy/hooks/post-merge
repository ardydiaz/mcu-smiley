#!/usr/bin/env bash
# Deploys to production after every `git pull` on main (enabled with: git config core.hooksPath deploy/hooks).
# Skip once with:  SMILEY_SKIP_DEPLOY=1 git pull
[ "${SMILEY_SKIP_DEPLOY:-}" = 1 ] && exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0

REPO=$(git rev-parse --show-toplevel)
# deploy.sh asks for the sudo password, so it needs a terminal (an editor's "Pull" button has none).
if ! sudo -n true 2>/dev/null && ! { : >/dev/tty; } 2>/dev/null; then
  echo "post-merge: no terminal for sudo; production NOT updated. Run: bash deploy/scripts/deploy.sh" >&2
  exit 0
fi
echo "post-merge: deploying to production (SMILEY_SKIP_DEPLOY=1 to skip)"
bash "$REPO/deploy/scripts/deploy.sh" </dev/tty || echo "post-merge: deploy FAILED; fix and re-run: bash deploy/scripts/deploy.sh" >&2
