NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smiley_face
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
ALLOW_ADMIN_REGISTRATION=false
SSO_ENABLED=false
SSO_PROVIDER_NAME=Microsoft
# For generic OIDC providers, fill the SSO_* URLs below.
# For Microsoft Entra ID, leave those URLs blank and fill the AZURE_* values.
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:4100/api/auth/sso/callback
SSO_SCOPES=openid email profile
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:4100/api/auth/microsoft/callback

# Posts a daily digest of dissatisfied ("sad") votes to a Microsoft Teams
# channel. Leave TEAMS_SMILEY_WEBHOOK_URL blank to disable the feature.
TEAMS_SMILEY_WEBHOOK_URL=
TEAMS_DIGEST_CRON=59 23 * * *
TEAMS_DIGEST_TIMEZONE=Asia/Manila
# Publicly reachable base URL for this API (e.g. https://feedback.mcu.edu.ph/api).
# Used to build the "Download Excel Report" link in the Teams digest card.
# Leave blank in local dev to fall back to http://localhost:<PORT>/api
# (only openable from the same machine).
PUBLIC_API_BASE_URL=
